# Neon PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Frontend origins, comma-separated
CORS_ORIGINS=https://shop.ferixas.com,http://localhost:3000

# Cloudinary media storage (enable when merchant uploads are turned on)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Resend transactional email (enable for verification, receipts and password reset)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Ferixas <no-reply@your-verified-domain.com>

# Runtime
PORT=8000
