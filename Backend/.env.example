# Neon PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Frontend origins, comma-separated
CORS_ORIGINS=https://shop.ferixas.com,http://localhost:3000

# Canonical public URLs; change these when deploying to another host.
PUBLIC_API_URL=http://127.0.0.1:8000
PUBLIC_APP_URL=http://localhost:3000

# Cloudinary media storage (primary upload provider; local disk is the MVP fallback)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Resend transactional email (enable for verification, receipts and password reset)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Ferixas <no-reply@your-verified-domain.com>

# Optional payment provider; checkout remains recorded but not externally captured until configured.
PAYMENT_PROVIDER_KEY=

# Runtime
PORT=8000
