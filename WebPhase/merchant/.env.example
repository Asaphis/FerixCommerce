# The real FastAPI commerce backend.
# Use http://127.0.0.1:8003 locally, or set the deployed HTTPS URL in production.
# Never commit real secrets.
FERIX_API_BASE=http://127.0.0.1:8003
CODEWORDS_API_KEY=

# Also accepted, in this order, if FERIX_API_BASE is not set:
#   NEXT_PUBLIC_API_URL
#   API_BASE_URL
#   NEXT_PUBLIC_API_BASE
#   API_URL
# Without any of them the app still runs; requests go to its own origin.
