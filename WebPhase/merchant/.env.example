# The existing hosted commerce REST API. The frontend never connects directly
# to PostgreSQL/Neon. Override both values only when using another API host.
FERIX_API_BASE=https://shopapi.ferixas.com
NEXT_PUBLIC_FERIX_API_BASE=https://shopapi.ferixas.com
# Never commit real secrets.
CODEWORDS_API_KEY=

# Also accepted if the FERIX-specific settings are absent:
#   NEXT_PUBLIC_API_URL
#   API_BASE_URL
#   NEXT_PUBLIC_API_BASE
#   API_URL
# Without any override, requests use https://shopapi.ferixas.com.
