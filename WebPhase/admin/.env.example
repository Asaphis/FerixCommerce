# Environment the admin console expects at runtime.
#
# The frontend uses the existing hosted REST API only; it never connects
# directly to PostgreSQL/Neon. Override both values only for another API host.
FERIX_API_BASE=https://shopapi.ferixas.com
NEXT_PUBLIC_FERIX_API_BASE=https://shopapi.ferixas.com

# Optional: only needed when the console calls CodeWords services directly.
# CODEWORDS_API_KEY=

# Also accepted if the FERIX-specific settings are absent:
#   NEXT_PUBLIC_API_URL
#   API_BASE_URL
#   NEXT_PUBLIC_API_BASE
#   API_URL
# Without any override, requests use https://shopapi.ferixas.com.
