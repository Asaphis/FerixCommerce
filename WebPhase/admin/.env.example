# Environment the admin console expects at runtime.
#
# Copy to .env.local for development and set the same variable in the
# deployment environment. It is the only API endpoint setting.
FERIX_API_BASE=http://127.0.0.1:8003

# Optional: only needed when the console calls CodeWords services directly.
# CODEWORDS_API_KEY=

# Also accepted, in this order, if FERIX_API_BASE is not set:
#   NEXT_PUBLIC_API_URL
#   API_BASE_URL
#   NEXT_PUBLIC_API_BASE
#   API_URL
# Without any of them the app still runs; requests go to its own origin.
